{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arckit.org/schemas/uk-food-sfbb-data-1.0.schema.json",
  "title": "UK food overlay: SFBB caterers pack data, version 1.0",
  "description": "Shape of every file in plugins/arckit-uk-food/data/<data id>/. Each file validates against one entry of the oneOf below; the front matter, diary and limits files are added to it later.",
  "oneOf": [
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/sectionFile"
    }
  ],
  "$defs": {
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "pageList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url",
        "publication",
        "retrieved",
        "file",
        "sha256",
        "pages",
        "licence",
        "attribution"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "const": "Food Standards Agency"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publication": {
          "type": "string",
          "format": "uri"
        },
        "retrieved": {
          "type": "string",
          "format": "date"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pages": {
          "const": 100
        },
        "licence": {
          "const": "OGL-3.0"
        },
        "attribution": {
          "const": "Contains public sector information licensed under the Open Government Licence v3.0."
        }
      }
    },
    "sectionFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "data",
        "section",
        "methods"
      ],
      "properties": {
        "schema": {
          "const": "uk-food-sfbb-data-1.0"
        },
        "data": {
          "const": "sfbb-caterers-2026-11-17"
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "title",
        "intro"
      ],
      "properties": {
        "id": {
          "enum": [
            "XC",
            "CL",
            "CH",
            "CK",
            "MG"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pages": {
          "$ref": "#/$defs/pageList"
        },
        "intro": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textItem"
          }
        }
      }
    },
    "textItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "page"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "pages",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2}-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "pages": {
          "$ref": "#/$defs/pageList"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "type": {
          "enum": [
            "yes-no",
            "yes-no-else",
            "tick",
            "text",
            "list",
            "note"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "elseText": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "$comment": "Any question but a note may have empty text: its prompt is then its block's column headings and its row's point. A note is FSA text printed in an answer column that asks nothing.",
      "if": {
        "properties": {
          "type": {
            "const": "note"
          }
        }
      },
      "then": {
        "properties": {
          "text": {
            "minLength": 1
          },
          "options": {
            "maxItems": 0
          },
          "elseText": {
            "const": null
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "columnGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "from",
        "to"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 0
        }
      },
      "$comment": "A label printed across several columns of a two-level table header, over the block's columns from `from` to `to` (0-based, inclusive). The label is page text. validateData also checks what the schema cannot express: from is not after to, to is a column of the block, and groups do not overlap."
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "page"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "point": {
          "type": [
            "string",
            "null"
          ]
        },
        "why": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "questions": {
          "$ref": "#/$defs/questions"
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page",
            "rows"
          ],
          "properties": {
            "kind": {
              "const": "points"
            },
            "heading": {
              "type": [
                "string",
                "null"
              ]
            },
            "page": {
              "$ref": "#/$defs/page"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page",
            "rows"
          ],
          "properties": {
            "kind": {
              "const": "manage-it"
            },
            "heading": {
              "type": [
                "string",
                "null"
              ]
            },
            "page": {
              "$ref": "#/$defs/page"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page"
          ],
          "properties": {
            "kind": {
              "const": "check-it"
            },
            "heading": {
              "type": [
                "string",
                "null"
              ]
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "$comment": "As on manage-it: the box name stays in heading; the other column headings printed in the box's header row go here."
            },
            "page": {
              "$ref": "#/$defs/page"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "questions": {
              "$ref": "#/$defs/questions"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "think-twice"
            },
            "heading": {
              "type": [
                "string",
                "null"
              ]
            },
            "page": {
              "$ref": "#/$defs/page"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "prove-it"
            },
            "heading": {
              "type": [
                "string",
                "null"
              ]
            },
            "page": {
              "$ref": "#/$defs/page"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "heading": {
              "type": [
                "string",
                "null"
              ]
            },
            "page": {
              "$ref": "#/$defs/page"
            },
            "text": {
              "type": "string"
            },
            "fromImage": {
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page",
            "wrong",
            "prevent"
          ],
          "properties": {
            "kind": {
              "const": "wrong"
            },
            "heading": {
              "type": [
                "string",
                "null"
              ]
            },
            "page": {
              "$ref": "#/$defs/page"
            },
            "wrongHeading": {
              "type": [
                "string",
                "null"
              ]
            },
            "preventHeading": {
              "type": [
                "string",
                "null"
              ]
            },
            "wrong": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "prevent": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "diaryNote": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page",
            "columns",
            "rows"
          ],
          "properties": {
            "kind": {
              "const": "table"
            },
            "heading": {
              "type": [
                "string",
                "null"
              ]
            },
            "page": {
              "$ref": "#/$defs/page"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "columnGroups": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/columnGroup"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "questions": {
              "$ref": "#/$defs/questions"
            }
          }
        }
      ]
    }
  }
}
