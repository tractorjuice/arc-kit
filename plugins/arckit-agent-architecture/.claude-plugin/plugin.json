  "license": "MIT",
  "icon": "./assets/icon.svg",
  "privacyPolicyUrl": "https://arckit.org/privacy.html",
  "supportUrl": "https://github.com/tractorjuice/arc-kit/issues",
  "documentationUrl": "https://github.com/tractorjuice/arckit-claude/tree/main/plugins/agent/architecture#readme",
  "termsOfServiceUrl": "https://github.com/tractorjuice/arckit-claude/blob/main/LICENSE",
  "defaultEnabled": false,
  "userConfig": {
    "default_classification": {
      "title": "Default Classification",
      "type": "string",
